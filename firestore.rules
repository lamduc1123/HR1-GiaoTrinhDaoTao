rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Bất kỳ ai cũng có thể đọc giáo án và lịch sử phiên bản để xem theo thời gian thực
    match /curriculums/{document=**} {
      allow read: if true;
      allow write: if true; // Hoặc 'if request.auth != null;' khi bật xác thực Firebase Auth nghiêm ngặt
    }
    
    match /curriculum_versions/{versionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Phiên bản đã lưu không được sửa xóa để đảm bảo toàn vẹn lịch sử
    }
  }
}
